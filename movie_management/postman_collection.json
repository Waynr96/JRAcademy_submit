        {
          "name": "List Movies - Keyword Search (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All results contain the keyword\", function () {",
                  "  const movies = pm.response.json();",
                  "  pm.expect(movies.length).to.be.above(0);",
                  "  movies.forEach((movie) => {",
                  "    const haystack = (movie.title + movie.description).toLowerCase();",
                  "    pm.expect(haystack).to.include(\"matrix\");",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/movies?keyword=matrix",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "movies"],
              "query": [{ "key": "keyword", "value": "matrix" }]
            }
          }
        },
        {
          "name": "List Movies - Sort by Rating Desc (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Results sorted by averageRating descending\", function () {",
                  "  const movies = pm.response.json();",
                  "  for (let i = 1; i < movies.length; i++) {",
                  "    pm.expect(movies[i - 1].averageRating).to.be.at.least(movies[i].averageRating);",
                  "  }",
                  "});"
