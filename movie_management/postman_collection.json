{
  "info": {
    "name": "Movie Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "movie-management-collection"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "movieId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "nonExistentId", "value": "000000000000000000000000" }
  ],
  "item": [
    {
      "name": "Movies",
      "item": [
        {
          "name": "Create Movie - Success (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response body matches created movie\", function () {",
                  "  const movie = pm.response.json();",
                  "  pm.expect(movie).to.have.property(\"_id\");",
                  "  pm.expect(movie.title).to.eql(\"The Matrix\");",
                  "  pm.expect(movie.description).to.eql(\"A hacker discovers the true nature of reality.\");",
                  "  pm.expect(movie.types).to.eql([\"Sci-Fi\"]);",
                  "  pm.expect(movie.averageRating).to.eql(0);",
                  "  pm.expect(movie.reviews).to.be.an(\"array\").that.is.empty;",
                  "  pm.collectionVariables.set(\"movieId\", movie._id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Matrix\",\n  \"description\": \"A hacker discovers the true nature of reality.\",\n  \"types\": [\"Sci-Fi\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/movies",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "movies"]
            }
          }
        },
        {
